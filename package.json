{
  "name": "kantolist",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts"
  },
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && tsx scripts/migrate-deploy.ts && tsx scripts/reset-production.ts && tsx scripts/seed-if-empty.ts && next build",
    "start": "next start",
    "lint": "eslint src/ scripts/",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "postinstall": "prisma generate",
    "seed:reference": "tsx --env-file-if-exists=.env scripts/seed.ts --reference-only",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "photo-credits": "tsx scripts/photo-credits.ts",
    "mock-trustclub": "node scripts/mock-trustclub.mjs",
    "seed-if-empty": "tsx --env-file-if-exists=.env scripts/seed-if-empty.ts",
    "migrate-deploy": "tsx --env-file-if-exists=.env scripts/migrate-deploy.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@vercel/blob": "^2.8.0",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.4.6",
    "jest": "^30.0.5",
    "prisma": "^6.13.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.3",
    "typescript": "5.9.2"
  }
}
