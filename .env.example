# Postgres
DATABASE_URL="postgresql://user:pass@localhost:5432/kantolist"

# Signing secret for the session cookie (openssl rand -base64 32)
AUTH_SECRET=""

# TrustClub OIDC (device authorization grant).
# The issuer MUST end with a trailing slash.
TRUSTCLUB_AUTH_ISSUER="https://trustclub.app/v1/connect/"
TRUSTCLUB_AUTH_CLIENT_ID=""
TRUSTCLUB_AUTH_CLIENT_SECRET=""

# Optional: allow /api/auth/dev-login outside production. Never set in prod.
ALLOW_DEV_LOGIN=""

# Destructive seed guard — required when DATABASE_URL is not localhost.
ALLOW_DESTRUCTIVE_SEED=""
